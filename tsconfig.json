{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./types", "./node_modules/@types", "./.nuxt/types"],
    "paths": {
      "./*": ["./*"],
      "~/*": ["app/*"],
      "#imports": [
        ".nuxt/imports.d.ts"
      ],
      "#app": [
        ".nuxt/types/app/index.d.ts"
      ]
    },
    "strict": true,
    "baseUrl": ".",
    "moduleResolution": "node"
  }
}